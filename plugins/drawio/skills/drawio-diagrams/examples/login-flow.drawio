<mxfile host="drawio-local" compressed="false">
  <diagram id="login-flow" name="Login Flow">
    <mxGraphModel adaptiveColors="auto" dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="827">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="submit" value="Submit credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="password" value="Password valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="two-factor" value="Two-factor valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="success" value="Signed in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="password-error" value="Invalid password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="175" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="two-factor-error" value="Invalid verification code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="335" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="submit-password" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="submit" target="password">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="password-valid" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="password" target="two-factor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="password-invalid" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="password" target="password-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="factor-valid" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="two-factor" target="success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="factor-invalid" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="two-factor" target="two-factor-error">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
